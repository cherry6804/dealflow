DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/dealflow
CORS_ALLOWED_ORIGINS=http://localhost:5174

SSO_SIBVO_BASE_URL=http://localhost:8000/api/v1
SSO_DEALSFLO_CLIENT_ID=dealsflo
SSO_DEALSFLO_CLIENT_SECRET=
SSO_DEALSFLO_REDIRECT_URI=http://localhost:5174/sso/callback
SSO_HTTP_TIMEOUT_SECONDS=5
SSO_REVALIDATION_INTERVAL_SECONDS=30

# Email outbox encryption (secret: generate a Fernet key, never commit a value).
EMAIL_OUTBOX_ENCRYPTION_KEY=

# Transactional outbox dispatch (defaults are bounded; see config.py).
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_SECONDS=30
OUTBOX_MAX_BACKOFF_SECONDS=3600
OUTBOX_LEASE_SECONDS=300
OUTBOX_BATCH_SIZE=50
